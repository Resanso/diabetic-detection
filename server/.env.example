# Salin menjadi server/.env lalu isi. Berkas .env jangan dibagikan atau di-commit.

# SATUSEHAT (Kemenkes). Ambil di https://satusehat.kemkes.go.id/platform, menu Kode Akses API.
SATUSEHAT_ENV=sandbox            # sandbox atau production
SATUSEHAT_ORG_ID=
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
# SATUSEHAT_LOCATION_ID=         # opsional; kosong = server membuat Location "Ruang Skrining Retina" sendiri
# SATUSEHAT_AUTO=1               # 1 = kirim otomatis setelah dokter menyimpan bacaan

# BPJS VClaim (opsional)
# BPJS_CONS_ID=
# BPJS_SECRET=
# BPJS_USER_KEY=
